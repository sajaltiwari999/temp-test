"""
database.py — SQLite Database Layer for DeviceMgr CMS

FIX APPLIED:
  query_db() now ALWAYS returns plain Python dicts (or list[dict]).
  sqlite3.Row objects are converted at the boundary and never leak
  to callers. This eliminates ALL AttributeError: 'sqlite3.Row' has
  no attribute 'get' errors throughout the codebase.
"""

import sqlite3
import os
from datetime import datetime, timezone
from flask import g
from config import Config


# ── CONNECTION MANAGEMENT ─────────────────────────────────────────────────

def get_db():
    """Return the SQLite connection for the current request (g-cached)."""
    if "db" not in g:
        g.db = sqlite3.connect(
            Config.DATABASE_PATH,
            detect_types=sqlite3.PARSE_DECLTYPES | sqlite3.PARSE_COLNAMES,
            check_same_thread=False,
        )
        # Use Row factory inside the connection for column-name access,
        # but we convert to dict before returning from query_db().
        g.db.row_factory = sqlite3.Row
        g.db.execute("PRAGMA journal_mode=WAL")
        g.db.execute("PRAGMA foreign_keys=ON")
    return g.db


def close_db(e=None):
    """Close connection at end of request (registered as Flask teardown)."""
    db = g.pop("db", None)
    if db is not None:
        db.close()


def _row_to_dict(row):
    """Convert a sqlite3.Row to a plain dict. Safe if already a dict or None."""
    if row is None:
        return None
    if isinstance(row, dict):
        return row
    return dict(row)


def query_db(query, args=(), one=False):
    """
    Execute a SELECT and return plain Python dicts — NEVER sqlite3.Row objects.

    Args:
        query: SQL string
        args:  parameter tuple (prevents SQL injection)
        one:   True  → return dict | None
               False → return list[dict]
    """
    cur = get_db().execute(query, args)
    rows = cur.fetchall()
    cur.close()
    if one:
        return _row_to_dict(rows[0]) if rows else None
    return [_row_to_dict(r) for r in rows]


def execute_db(query, args=()):
    """Execute INSERT/UPDATE/DELETE and commit. Returns lastrowid."""
    db = get_db()
    cur = db.execute(query, args)
    db.commit()
    return cur.lastrowid


def executemany_db(query, args_list):
    """Batch INSERT/UPDATE in a single transaction."""
    db = get_db()
    db.executemany(query, args_list)
    db.commit()


def now_utc():
    """Current UTC time as ISO 8601 string."""
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


