def _migrate_live_sessions(conn):
    """
    Ensure an old/incomplete live_sessions table cannot prevent the
    current schema from starting.

    Earlier development versions may have created a live_sessions table
    without the columns required by the current implementation.
    SQLite's CREATE TABLE IF NOT EXISTS does not upgrade such a table.
    """

    existing = conn.execute(
        """
        SELECT name
        FROM sqlite_master
        WHERE type='table' AND name='live_sessions'
        """
    ).fetchone()

    if not existing:
        return

    columns = {
        row["name"]
        for row in conn.execute("PRAGMA table_info(live_sessions)").fetchall()
    }

    required_columns = {
        "session_id",
        "device_id",
        "stream_type",
        "capture_method",
        "camera_facing",
        "status",
        "requested_fps",
        "start_command_id",
        "stop_command_id",
        "error",
        "created_at",
        "started_at",
        "stopped_at",
        "last_activity_at",
    }

    if required_columns.issubset(columns):
        return

    # Remove indexes that may have been created for the incompatible table.
    conn.execute("DROP INDEX IF EXISTS idx_live_sessions_device")
    conn.execute("DROP INDEX IF EXISTS idx_live_sessions_status")

    # Preserve the old table instead of deleting it.
    # It is renamed so the current schema can create a clean live_sessions table.
    backup_name = (
        "live_sessions_legacy_"
        + datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    )

    conn.execute(
        f'ALTER TABLE live_sessions RENAME TO "{backup_name}"'
    )

    conn.commit()

