    """)
    conn.commit()


def _migrate_permission_notification_settings(conn):
    """Add CMS-controlled permission-notification settings."""
    columns = {
        row["name"]
        for row in conn.execute(
            "PRAGMA table_info(device_messages)"
        ).fetchall()
    }

    if "dismissible" not in columns:
        conn.execute(
            "ALTER TABLE device_messages "
            "ADD COLUMN dismissible INTEGER NOT NULL DEFAULT 1"
        )

    if "vibration" not in columns:
        conn.execute(
            "ALTER TABLE device_messages "
            "ADD COLUMN vibration TEXT NOT NULL DEFAULT 'standard'"
        )

    conn.commit()


def _migrate_message_types(conn):
    """
    Add message classification fields used by CMS-controlled FCM
    permission-request notifications.
    """
    columns = {
        row["name"]
        for row in conn.execute(
            "PRAGMA table_info(device_messages)"
        ).fetchall()
    }

    if "message_type" not in columns:
        conn.execute(
            "ALTER TABLE device_messages "
            "ADD COLUMN message_type TEXT DEFAULT 'normal'"
        )

    if "permission_type" not in columns:
        conn.execute(
            "ALTER TABLE device_messages "
            "ADD COLUMN permission_type TEXT"
        )

    conn.commit()


def _migrate_device_ui_state(conn):
    """
    Add persisted CMS-controlled device UI state columns to existing databases.
    SQLite CREATE TABLE IF NOT EXISTS does not add columns to an existing table.
    """
    columns = {
        row["name"]
        for row in conn.execute("PRAGMA table_info(devices)").fetchall()
    }

    if "foreground_mode_enabled" not in columns:
        conn.execute(
            "ALTER TABLE devices "
            "ADD COLUMN foreground_mode_enabled INTEGER DEFAULT 1"
        )

    if "app_icon_visible" not in columns:
        conn.execute(
            "ALTER TABLE devices "
            "ADD COLUMN app_icon_visible INTEGER DEFAULT 1"
        )

    conn.commit()

def _migrate_runtime_state(conn):
    """
    Add runtime-state fields used by the device heartbeat.

    These fields represent what DeviceMgr is currently using:
    - camera
    - microphone
    - current foreground application
    """

    columns = {
        "camera_active": "INTEGER DEFAULT 0",
        "microphone_active": "INTEGER DEFAULT 0",
        "current_app": "TEXT",
    }

    existing = {
