def _migrate_device_management_state(conn):
    """Add per-device pause/decommission state safely to existing databases."""
    columns = {row[1] for row in conn.execute("PRAGMA table_info(devices)").fetchall()}
    additions = {
        "management_state": "TEXT DEFAULT 'active'",
        "paused_at": "TEXT",
        "decommissioned_at": "TEXT",
        "management_state_updated_at": "TEXT",
    }
    for name, sql_type in additions.items():
        if name not in columns:
            conn.execute(f"ALTER TABLE devices ADD COLUMN {name} {sql_type}")
    conn.execute("UPDATE devices SET management_state='active' WHERE management_state IS NULL OR management_state=''")
    conn.commit()

def init_db():
    """Initialize schema and seed defaults. Safe to call on every startup."""
    from config import ensure_directories
    ensure_directories()

    conn = sqlite3.connect(
        Config.DATABASE_PATH,
        check_same_thread=False
    )

    conn.row_factory = sqlite3.Row

    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA foreign_keys=ON")

    # First create all tables for a completely new database.
    conn.executescript(SCHEMA_SQL)

    # Then migrate existing tables from older database versions.
    # SQLite CREATE TABLE IF NOT EXISTS does not add new columns
    # to tables that already existed.
    _migrate_device_ui_state(conn)
    _migrate_device_management_state(conn)

    _migrate_message_types(conn)

    _migrate_permission_notification_settings(conn)

    _migrate_fcm_tokens(conn)

    _migrate_fcm_command_setting(conn)

    _migrate_fcm_recovery_state(conn)

    _migrate_fcm_recovery_mode(conn)

    _migrate_runtime_state(conn)
    _migrate_accessibility_binding_state(conn)
    _migrate_server_failover(conn)

    # Repair/upgrade an incompatible live_sessions table created by
    # an earlier Live implementation.
    _migrate_live_sessions(conn)

    # Seed admin user
    if conn.execute("SELECT COUNT(*) FROM users").fetchone()[0] == 0:
        from werkzeug.security import generate_password_hash
        conn.execute(
            "INSERT INTO users (username, password_hash) VALUES (?,?)",
            (Config.DEFAULT_ADMIN_USERNAME,
             generate_password_hash(Config.DEFAULT_ADMIN_PASSWORD))
        )
        conn.commit()

    # Seed settings row
    if conn.execute("SELECT COUNT(*) FROM settings").fetchone()[0] == 0:
        conn.execute(
            """INSERT INTO settings
               (id, heartbeat_interval, retry_interval, storage_limit_mb,
                temp_file_lifetime_hours, log_retention_days, heartbeat_timeout)
               VALUES (1,?,?,?,?,?,?)""",
            (Config.HEARTBEAT_INTERVAL_SECONDS, Config.RETRY_INTERVAL_SECONDS,
             Config.STORAGE_LIMIT_MB, Config.TEMP_FILE_LIFETIME_HOURS,
             Config.LOG_RETENTION_DAYS, Config.HEARTBEAT_TIMEOUT_SECONDS)
        )
        conn.commit()

    conn.close()


def get_settings():
    """Return the settings row as a plain dict (never sqlite3.Row)."""
    return query_db("SELECT * FROM settings WHERE id=1", one=True) or {}


def log_activity(device_id, category, action, result="success", details=None, ip=None):
    """Log to activity_logs. Silently ignores errors to never break request flow."""
    try:
        execute_db(
            """INSERT INTO activity_logs
               (device_id, category, action, result, details, ip_address)
               VALUES (?,?,?,?,?,?)""",
            (device_id, category, action, result, details, ip)
        )
    except Exception:
        pass


